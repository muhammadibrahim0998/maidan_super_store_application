# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# 1. MySQL Database Configuration (Local XAMPP / phpMyAdmin / VPS)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=perfume_shop_center_hayaseri

# 2. Or Cloud MySQL URL (Railway, PlanetScale, Aiven, Clever Cloud, Render)
# If provided, DATABASE_URL or MYSQL_URL takes priority:
# DATABASE_URL=mysql://root:password@host:3306/perfume_shop_center_hayaseri
# MYSQL_URL=mysql://root:password@host:3306/perfume_shop_center_hayaseri
# Enable SSL for cloud databases if required:
# MYSQL_SSL=false

# 3. Server Port & Environment
PORT=5004
NODE_ENV=development

# 4. Frontend Domain URL (For CORS & Invoice / Stripe checkout redirects)
FRONTEND_URL=http://localhost:5174

# 5. Cloudinary Storage (Image Uploads)
CLOUDINARY_CLOUD_NAME=dgatodhtt
CLOUDINARY_URL=cloudinary://785123614929457:atFL4ME8mDGz6nEN0uopD2b9cU4@dgatodhtt
CLOUDINARY_API_KEY=785123614929457
